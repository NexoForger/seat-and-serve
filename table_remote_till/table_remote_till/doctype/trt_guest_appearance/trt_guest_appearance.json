{
 "doctype": "DocType",
 "name": "TRT Guest Appearance",
 "module": "Table Remote Till",
 "engine": "InnoDB",
 "autoname": "hash",
 "title_field": "company",
 "show_title_field_in_link": 1,
 "istable": 0,
 "field_order": [
  "company", "brand_logo",
  "palette_section", "primary_color", "accent_color", "page_color", "surface_color", "text_color", "muted_color",
  "type_section", "heading_font", "body_font",
  "content_section", "brand_title_en", "brand_title_ar", "brand_tagline_en", "brand_tagline_ar", "hero_title_en", "hero_title_ar",
  "hero_subtitle_en", "hero_subtitle_ar", "hero_image",
  "layout_section", "layout_style", "card_style",
  "motion_section", "loading_message_en", "loading_message_ar", "loading_style", "empty_style", "success_style", "motion_style"
 ],
 "fields": [
  {"fieldname":"company","fieldtype":"Link","label":"Company","options":"Company","reqd":1,"unique":1,"in_list_view":1},
  {"fieldname":"brand_logo","fieldtype":"Attach Image","label":"Brand Logo"},
  {"fieldname":"palette_section","fieldtype":"Section Break","label":"Color Palette"},
  {"fieldname":"primary_color","fieldtype":"Color","label":"Primary Color","default":"#171917"},
  {"fieldname":"accent_color","fieldtype":"Color","label":"Accent Color","default":"#e8f574"},
  {"fieldname":"page_color","fieldtype":"Color","label":"Page Background","default":"#f7f8f3"},
  {"fieldname":"surface_color","fieldtype":"Color","label":"Card and Panel Background","default":"#ffffff"},
  {"fieldname":"text_color","fieldtype":"Color","label":"Text Color","default":"#171917"},
  {"fieldname":"muted_color","fieldtype":"Color","label":"Secondary Text Color","default":"#686d67"},
  {"fieldname":"type_section","fieldtype":"Section Break","label":"Typography"},
  {"fieldname":"heading_font","fieldtype":"Select","label":"Heading Font","options":"Manrope\nDM Sans\nLato\nNunito","default":"Manrope"},
  {"fieldname":"body_font","fieldtype":"Select","label":"Body Font","options":"DM Sans\nManrope\nLato\nNunito","default":"DM Sans"},
  {"fieldname":"content_section","fieldtype":"Section Break","label":"Guest Facing Brand and Welcome"},
  {"fieldname":"brand_title_en","fieldtype":"Data","label":"Brand Title (English)"},
  {"fieldname":"brand_title_ar","fieldtype":"Data","label":"Brand Title (Arabic)"},
  {"fieldname":"brand_tagline_en","fieldtype":"Data","label":"Brand Tagline (English)"},
  {"fieldname":"brand_tagline_ar","fieldtype":"Data","label":"Brand Tagline (Arabic)"},
  {"fieldname":"hero_title_en","fieldtype":"Data","label":"Welcome Heading (English)"},
  {"fieldname":"hero_title_ar","fieldtype":"Data","label":"Welcome Heading (Arabic)"},
  {"fieldname":"hero_subtitle_en","fieldtype":"Small Text","label":"Welcome Description (English)"},
  {"fieldname":"hero_subtitle_ar","fieldtype":"Small Text","label":"Welcome Description (Arabic)"},
  {"fieldname":"hero_image","fieldtype":"Attach Image","label":"Welcome Image"},
  {"fieldname":"layout_section","fieldtype":"Section Break","label":"Menu Layout"},
  {"fieldname":"layout_style","fieldtype":"Select","label":"Menu Layout","options":"Cards\nCompact list","default":"Cards"},
  {"fieldname":"card_style","fieldtype":"Select","label":"Card Shape","options":"Soft\nRounded\nSquare","default":"Rounded"},
  {"fieldname":"motion_section","fieldtype":"Section Break","label":"Loading and Feedback"},
  {"fieldname":"loading_message_en","fieldtype":"Data","label":"Loading Message (English)"},
  {"fieldname":"loading_message_ar","fieldtype":"Data","label":"Loading Message (Arabic)"},
  {"fieldname":"loading_style","fieldtype":"Select","label":"Loading Animation","options":"Food\nSparkle\nDots","default":"Food"},
  {"fieldname":"empty_style","fieldtype":"Select","label":"Empty State Style","options":"Illustrated\nSimple","default":"Illustrated"},
  {"fieldname":"success_style","fieldtype":"Select","label":"Success Animation","options":"Confetti\nSparkle\nCheck","default":"Sparkle"},
  {"fieldname":"motion_style","fieldtype":"Select","label":"Motion Style","options":"Playful\nCalm\nReduced","default":"Playful"}
 ],
 "permissions": [
  {"role":"System Manager","read":1,"write":1,"create":1,"delete":1,"print":1,"report":1,"export":1},
  {"role":"TRT Manager","read":1,"write":1,"create":1,"delete":1,"print":1,"report":1,"export":1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
